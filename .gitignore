# dependencies
/node_modules

# next.js build output
/.next/
/out/
next-env.d.ts

# production
/build

# env files — never commit real secrets
.env
.env.local
.env.*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor/OS
.DS_Store
*.pem
.vscode/
.idea/

.vercel

# Real env files — every actual secret. The broad `.env*` would also catch .env.local.example,
# which is the safe, secret-free template and is exactly the file that SHOULD be tracked — it's
# what documents which keys to refill after a restore. `!` re-includes it after the broad exclude.
.env*
!.env.local.example

# Claude Code local-only settings (machine-specific permission allowlist, temp paths)
.claude/settings.local.json

# TypeScript incremental build cache
tsconfig.tsbuildinfo
