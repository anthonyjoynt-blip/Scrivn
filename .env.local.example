# Copy this file to .env.local (which is gitignored) and fill in your real values.
# .env.local is loaded automatically by `next dev` / `next start` — nothing else to configure.
#
# For where to find the Supabase values and the dashboard settings that go with them,
# see supabase/README.md.

ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the Claude model used for both extraction and document generation.
# Defaults to claude-opus-5 (see lib/anthropic.ts) if unset.
# ANTHROPIC_MODEL=claude-opus-5


# ---- Supabase (authentication) --------------------------------------------------------------

# Project URL. Public: compiled into the browser bundle, as intended.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key. Also public and also intended to be — it identifies the project and
# carries no privileges of its own. Every table it can reach is governed by Row Level Security
# (see supabase/migrations/0001_profiles.sql), which is what actually protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# The service_role / secret key. THIS ONE IS A REAL SECRET — treat it exactly like
# ANTHROPIC_API_KEY above, with one extra consideration: it bypasses Row Level Security entirely,
# so anyone holding it has full unrestricted read/write access to every row in the database.
#
# Never put it in a NEXT_PUBLIC_ variable, never import it into anything under app/ that isn't a
# Route Handler or Server Component, and never send it to the browser.
#
# Nothing in the current codebase reads this. The auth flow doesn't need it: profile rows are
# created by a database trigger, and everything else goes through the anon key plus RLS. It's
# listed here so it's on hand — and correctly labelled — when something genuinely does need it
# (a background job or admin task that must legitimately act across users).
SUPABASE_SERVICE_ROLE_KEY=


# ---- Stripe (payments) ------------------------------------------------------------------------
# Use sandbox/test keys (pk_test_ / sk_test_) for development. Nothing reads these yet.

# Public by design — goes to the browser, can only create payment attempts.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret — full API access to the Stripe account. Server-side only, never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...

# Produced when a webhook endpoint exists (`stripe listen` locally, or the dashboard in production).
# Without it, incoming webhooks can't be verified as genuinely from Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Resend (emails the app sends itself) ------------------------------------------------------
# SEPARATE from the Resend key configured in Supabase's SMTP settings. That one sends the two auth
# emails (confirm address, reset password) and lives in the Supabase dashboard. This one is for
# emails the application itself sends: welcome, usage warnings, and document delivery.
#
# Secret — can send mail as your domain. Server-side only, never NEXT_PUBLIC_.
# Create at resend.com → API Keys.
RESEND_API_KEY=re_...

# Base URL used for links inside emails (pricing, app). Falls back to https://scrivn.ca when unset;
# set it to http://localhost:3000 while testing so emailed links point at your dev server.
NEXT_PUBLIC_APP_URL=https://scrivn.ca


# ---- Marketing site ----------------------------------------------------------------------------

# Whether the public site advertises itself: "true" shows the nav links (How It Works / Pricing /
# FAQ / Contact), the Get Started button, and the home page's pricing teaser. Anything else — including
# leaving this unset — hides them, and the home page reads as a plain landing page.
#
# This is NOT an access control. The five marketing pages stay directly reachable by URL either way;
# the flag only decides whether the site links to them. Set it to "true" when you're ready to be found.
NEXT_PUBLIC_SHOW_MARKETING_NAV=false

# Where contact-form submissions are emailed. Without it, /api/contact tells the visitor messages
# aren't set up and logs the full submission to the server console so nothing is lost.
# Any address you can read — it's the recipient, not a sender, so it needn't be on a verified domain.
CONTACT_EMAIL=you@example.com

# Fails closed: only the exact string "true" opens these.
BILLING_ENABLED=true
NEXT_PUBLIC_SIGNUPS_OPEN=true
